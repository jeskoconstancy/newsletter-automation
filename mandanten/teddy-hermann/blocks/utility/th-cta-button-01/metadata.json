{
  "id": "TH_CTA_BUTTON_01",
  "brand": "teddy-hermann",
  "name": "Button – eigenständig",
  "version": "1.0.0",
  "category": "utility",
  "status": "stable",
  "purpose": "Eigenständiger Call-to-Action, z. B. unter einem Produktraster oder Bild.",
  "description": "Eckiger roter Button (weiß, fett 15px, Versalien), zentriert. Variante dunkelgrau. In den Referenzen sitzen Buttons in eigenen Rapidmail-Zeilen unter Text- und Bild-Text-Modulen (19 Buttons in 10 Newslettern).",
  "use_cases": [
    "call_to_action"
  ],
  "campaign_types": [
    "seasonal_campaign",
    "sale",
    "voucher",
    "gift_guide",
    "new_arrivals",
    "product_launch",
    "collection_spotlight",
    "contest",
    "free_gift",
    "free_shipping",
    "product_recommendations",
    "brand_story"
  ],
  "position": {
    "slot": "body",
    "unique": false,
    "max_per_newsletter": 3
  },
  "fields": {
    "label": {
      "type": "string",
      "required": true,
      "description": "Buttontext (Versalien automatisch).",
      "source": "ai_agent",
      "validation": {
        "min_length": 3,
        "max_length": 40
      }
    },
    "url": {
      "type": "url",
      "required": true,
      "description": "Ziel.",
      "source": "campaign_brief",
      "validation": {
        "https_only": true
      }
    },
    "variant": {
      "type": "enum",
      "required": false,
      "description": "primary = rot (Standard, 19/20 Buttons), secondary = dunkelgrau #545654 (versandkostenfrei – für ruhige Service-Aktionen).",
      "source": "ai_agent",
      "values": [
        "primary",
        "secondary"
      ],
      "default": "primary"
    },
    "preserve_case": {
      "type": "boolean",
      "required": false,
      "description": "true = Buttontext nicht in Versalien umwandeln (halloween, last_minute: 'Hier geht's zu den Gutscheinen!').",
      "source": "ai_agent",
      "default": false
    },
    "align": {
      "type": "enum",
      "required": false,
      "description": "Ausrichtung.",
      "source": "static_default",
      "values": [
        "center",
        "left"
      ],
      "default": "center"
    },
    "spacing_top": {
      "type": "enum",
      "required": false,
      "description": "Abstand oben. none = 0, s = 20px, m = 30px, l = 50px.",
      "source": "static_default",
      "values": [
        "none",
        "s",
        "m",
        "l"
      ],
      "default": "none"
    },
    "spacing_bottom": {
      "type": "enum",
      "required": false,
      "description": "Abstand unten. none = 0, s = 20px, m = 30px, l = 50px.",
      "source": "static_default",
      "values": [
        "none",
        "s",
        "m",
        "l"
      ],
      "default": "s"
    }
  },
  "image_requirements": [],
  "layout": {
    "desktop_columns": 1,
    "mobile_columns": 1,
    "full_width": false,
    "uses_background_image": false,
    "approx_height_px": {
      "desktop": 58,
      "mobile": 58
    },
    "space_weight": "xs"
  },
  "constraints": [
    "requires_label_and_url"
  ],
  "exclusion_criteria": [
    "Direkt nach einem Baustein, der schon einen Button hat."
  ],
  "compatibility": {
    "recommended_after": [
      "TH_PRODUCT_GRID_01",
      "TH_IMAGE_01"
    ],
    "recommended_before": [],
    "avoid_adjacent": [
      "TH_CTA_BUTTON_01"
    ],
    "hard_dependencies": []
  },
  "ai_hints": {
    "when_to_use": "Unter einem Produktraster ('ALLE NEUHEITEN ENTDECKEN').",
    "when_not_to_use": "Wenn der vorige Baustein schon einen Button hat.",
    "content_guidelines": "Kurz, aktiv, Versalien: JETZT ENTDECKEN, JETZT SPAREN, ZUR THEMENWELT."
  }
}