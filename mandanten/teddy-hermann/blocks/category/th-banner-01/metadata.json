{
  "id": "TH_BANNER_01",
  "brand": "teddy-hermann",
  "name": "Zwischenbanner – Themenbild (schmal oder hoch)",
  "version": "1.0.0",
  "category": "category",
  "status": "stable",
  "purpose": "Leitet einen zweiten Themenbereich ein (Personalisierung, Halloween-Special, Gewinnspiel, Themenwelt) und verlinkt dorthin.",
  "description": "700px-Bild über die volle Breite. Schmal (700×109, Claim im Bild) oder hoch (700×255, wie ein zweiter Hero). Steht zwischen zwei Inhaltsbereichen, meist gefolgt von TH_IMAGE_TEXT_01 oder TH_TEXT_01.",
  "use_cases": [
    "section_intro",
    "theme_world_teaser",
    "cross_selling",
    "contest_teaser"
  ],
  "campaign_types": [
    "seasonal_campaign",
    "sale",
    "voucher",
    "gift_guide",
    "new_arrivals",
    "product_launch",
    "collection_spotlight",
    "contest",
    "free_gift",
    "free_shipping",
    "product_recommendations",
    "brand_story"
  ],
  "position": {
    "slot": "body",
    "unique": false,
    "max_per_newsletter": 3
  },
  "fields": {
    "image": {
      "type": "image",
      "required": true,
      "description": "Bannergrafik 700px breit: schmal 700×109 oder hoch 700×255.",
      "source": "asset_pipeline",
      "validation": {
        "image_requirement": "banner_image"
      },
      "fields": {
        "url": {
          "type": "url",
          "required": true,
          "description": "Absolute HTTPS-URL (Rapidmail-Medienarchiv c.emailsys1a.net oder teddy-hermann-shop.de; im Vorschaumodus auch relativ).",
          "source": "asset_pipeline",
          "validation": {
            "https_only": true
          }
        },
        "alt": {
          "type": "string",
          "required": true,
          "description": "Alternativtext. Bei Bildern mit eingebranntem Text MUSS der Bildtext enthalten sein (wird bei blockierten Bildern angezeigt).",
          "source": "ai_agent",
          "validation": {
            "min_length": 3,
            "max_length": 140
          }
        },
        "width": {
          "type": "integer",
          "required": false,
          "description": "Pixelbreite der Originaldatei – nötig für Verhältnis-/Auflösungsprüfung.",
          "source": "asset_pipeline",
          "validation": {
            "min": 1
          }
        },
        "height": {
          "type": "integer",
          "required": false,
          "description": "Pixelhöhe der Originaldatei.",
          "source": "asset_pipeline",
          "validation": {
            "min": 1
          }
        },
        "asset_id": {
          "type": "string",
          "required": false,
          "description": "Referenz im Bildreferenz-Format (registry/asset-reference-schema.json).",
          "source": "asset_pipeline"
        },
        "rights_status": {
          "type": "enum",
          "required": false,
          "description": "Nutzungsfreigabe des Bildes.",
          "source": "asset_pipeline",
          "values": [
            "approved",
            "pending",
            "unknown",
            "rejected"
          ],
          "default": "unknown"
        }
      }
    },
    "link_url": {
      "type": "url",
      "required": false,
      "description": "Ziel des Banners (Themenwelt/Gewinnspiel). Empfohlen.",
      "source": "campaign_brief",
      "validation": {
        "https_only": true
      }
    },
    "spacing_top": {
      "type": "enum",
      "required": false,
      "description": "Abstand über dem Banner. none = 0, s = 20px, m = 30px, l = 50px.",
      "source": "static_default",
      "values": [
        "none",
        "s",
        "m",
        "l"
      ],
      "default": "none"
    },
    "spacing_bottom": {
      "type": "enum",
      "required": false,
      "description": "Abstand unter dem Banner (biene/osternest/muttertag: s). none = 0, s = 20px, m = 30px, l = 50px.",
      "source": "static_default",
      "values": [
        "none",
        "s",
        "m",
        "l"
      ],
      "default": "none"
    }
  },
  "image_requirements": [
    {
      "key": "banner_image",
      "field": "image",
      "image_type": "promo_banner",
      "aspect_ratio": "700:109",
      "aspect_ratio_alternatives": [
        "700:255",
        "6:1",
        "7:1",
        "5:1",
        "3:1"
      ],
      "display_width": 698,
      "min_width": 1400,
      "formats": [
        "jpg",
        "jpeg",
        "png",
        "gif"
      ],
      "alt_required": true,
      "crop": "kein Zuschnitt; 1400px für hochauflösende Displays",
      "focus": "Claim links, Produkte rechts (schmal); mobil bleibt der schmale Banner nur ~56px hoch – Bildschrift groß wählen",
      "usage": "Themen-/Aktionsbanner mit oder ohne Claim",
      "rendering": "img"
    }
  ],
  "layout": {
    "desktop_columns": 1,
    "mobile_columns": 1,
    "full_width": false,
    "uses_background_image": false,
    "approx_height_px": {
      "slim": 109,
      "tall": 255,
      "mobile_slim": 56
    },
    "space_weight": "m"
  },
  "constraints": [
    "requires_image",
    "alt_must_contain_image_text"
  ],
  "exclusion_criteria": [
    "Nicht direkt unter dem Hero (zwei Banner hintereinander wirken wie eine Bildwand).",
    "Kein 700px-Bild → TH_IMAGE_01."
  ],
  "compatibility": {
    "recommended_after": [
      "TH_TEXT_01",
      "TH_PRODUCT_GRID_01",
      "TH_IMAGE_TEXT_01"
    ],
    "recommended_before": [
      "TH_IMAGE_TEXT_01",
      "TH_TEXT_01",
      "TH_PRODUCT_GRID_01"
    ],
    "avoid_adjacent": [
      "TH_HERO_01",
      "TH_DIVIDER_01"
    ],
    "hard_dependencies": []
  },
  "ai_hints": {
    "when_to_use": "Für den zweiten Themenbereich eines Newsletters (Standard-Muster: Hero → Text → [Produkte] → Banner → Bild-Text-Modul).",
    "when_not_to_use": "Wenn nur ein Thema kommuniziert wird (last_minute).",
    "content_guidelines": "ALT-Text gibt den Bildclaim wieder, z. B. 'Kuscheltiere mit Personalisierung'."
  }
}