{
  "id": "TH_HEADER_01",
  "brand": "teddy-hermann",
  "name": "Header – Logo zentriert auf Weiß",
  "version": "1.0.0",
  "category": "header",
  "status": "stable",
  "purpose": "Markenkennung am Anfang jedes Teddy-Hermann-Newsletters.",
  "description": "Weiße Fläche mit dem 700px-Logobild (Schriftzug 'HERMANN Teddy ORIGINAL' + rotes Siegel, zentriert), verlinkt auf den Shop. 7px Abstand oben/unten. Keine Navigation, kein Textlink. In 10/10 Referenzen identisch.",
  "use_cases": [
    "brand_identification",
    "shop_entry"
  ],
  "campaign_types": [
    "seasonal_campaign",
    "sale",
    "voucher",
    "gift_guide",
    "new_arrivals",
    "product_launch",
    "collection_spotlight",
    "contest",
    "free_gift",
    "free_shipping",
    "product_recommendations",
    "brand_story"
  ],
  "position": {
    "slot": "first",
    "unique": true,
    "max_per_newsletter": 1
  },
  "fields": {
    "logo": {
      "type": "object",
      "required": true,
      "description": "Header-Logobild (url, alt, width).",
      "source": "shop_profile",
      "default_from": "shop.logo",
      "fields": {
        "url": {
          "type": "url",
          "required": true,
          "description": "Logo-/Headerbild (JPG/PNG).",
          "source": "shop_profile",
          "validation": {
            "https_only": true
          }
        },
        "alt": {
          "type": "string",
          "required": true,
          "description": "Alt-Text.",
          "source": "shop_profile",
          "validation": {
            "min_length": 2,
            "max_length": 60
          }
        },
        "width": {
          "type": "integer",
          "required": true,
          "description": "Anzeigebreite in px (Standard 700 = volle Breite, da Weißraum im Bild).",
          "source": "shop_profile",
          "default": 700,
          "validation": {
            "min": 120,
            "max": 700
          }
        },
        "height": {
          "type": "integer",
          "required": false,
          "description": "Pixelhöhe (Info).",
          "source": "shop_profile"
        },
        "preview_url": {
          "type": "string",
          "required": false,
          "description": "Lokales Bild für die Vorschau.",
          "source": "shop_profile"
        },
        "variant": {
          "type": "string",
          "required": false,
          "description": "Info.",
          "source": "shop_profile"
        }
      }
    },
    "link_url": {
      "type": "url",
      "required": true,
      "description": "Ziel des Logos (Standard: Shop-Startseite).",
      "source": "shop_profile",
      "validation": {
        "https_only": true
      },
      "default_from": "shop.urls.shop"
    }
  },
  "image_requirements": [
    {
      "key": "header_logo",
      "field": "logo",
      "image_type": "logo",
      "aspect_ratio": null,
      "display_width": 700,
      "min_width": 700,
      "formats": [
        "jpg",
        "png"
      ],
      "alt_required": true,
      "usage": "Logo zentriert auf Weiß, Weißraum im Bild enthalten",
      "rendering": "img"
    }
  ],
  "layout": {
    "desktop_columns": 1,
    "mobile_columns": 1,
    "full_width": false,
    "uses_background_image": false,
    "approx_height_px": {
      "desktop": 107,
      "mobile": 62
    },
    "space_weight": "xs"
  },
  "constraints": [
    "must_be_first_block",
    "exactly_one_per_newsletter",
    "data_usually_empty_uses_shop_profile"
  ],
  "exclusion_criteria": [],
  "compatibility": {
    "recommended_after": [],
    "recommended_before": [
      "TH_HERO_01"
    ],
    "avoid_adjacent": [
      "TH_DIVIDER_01"
    ],
    "hard_dependencies": []
  },
  "ai_hints": {
    "when_to_use": "Immer als erster Baustein.",
    "when_not_to_use": "Nie weglassen.",
    "content_guidelines": "Keine Daten nötig – alles kommt aus dem Shop-Profil."
  }
}