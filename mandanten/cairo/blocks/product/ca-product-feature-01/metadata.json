{
  "id": "CA_PRODUCT_FEATURE_01",
  "brand": "cairo",
  "name": "Produkt-Highlight – großes Bild, zentriert",
  "version": "1.0.0",
  "category": "product",
  "status": "stable",
  "purpose": "Ein Produkt mit großem Bild als ruhigen Blickfang zeigen.",
  "description": "Bild 600px (oder 400px) zentriert, darunter zentriert Modellname (21px fett), Produktart, optional kurze Beschreibung, 'UVP / Katalogpreis' durchgestrichen, Preis und Button – ohne Farbfläche ('Sessel Herby', 'Shining Star').",
  "use_cases": [
    "product_highlight"
  ],
  "campaign_types": [
    "seasonal_campaign",
    "sale",
    "voucher",
    "gift_guide",
    "new_arrivals",
    "product_launch",
    "collection_spotlight",
    "black_week",
    "contest",
    "free_gift",
    "free_shipping",
    "product_recommendations",
    "brand_story"
  ],
  "position": {
    "slot": "body",
    "unique": false,
    "max_per_newsletter": 2
  },
  "fields": {
    "product": {
      "type": "object",
      "required": false,
      "description": "Produkt als \"{{products.pXX}}\". Ohne Produkt: image + link_url.",
      "source": "product_feed",
      "fields": {
        "sku": {
          "type": "string",
          "required": false,
          "description": "Artikelnummer.",
          "source": "product_feed",
          "validation": {
            "max_length": 64
          }
        },
        "name": {
          "type": "string",
          "required": false,
          "description": "Feed-Titel (wird nicht angezeigt – Anzeige über headline).",
          "source": "product_feed"
        },
        "product_url": {
          "type": "url",
          "required": true,
          "description": "Produktdetailseite.",
          "source": "product_feed",
          "validation": {
            "https_only": true
          }
        },
        "image": {
          "type": "image",
          "required": true,
          "description": "Produktbild aus dem Feed.",
          "source": "product_feed",
          "validation": {
            "image_requirement": "product_image"
          },
          "fields": {
            "url": {
              "type": "url",
              "required": true,
              "description": "Absolute HTTPS-URL (cairo.de / news.cairo.de).",
              "source": "product_feed",
              "validation": {
                "https_only": true
              }
            },
            "alt": {
              "type": "string",
              "required": true,
              "description": "Alternativtext. Bei Grafiken mit eingebranntem Text MUSS der Bildtext enthalten sein.",
              "source": "ai_agent",
              "validation": {
                "min_length": 3,
                "max_length": 140
              }
            },
            "width": {
              "type": "integer",
              "required": false,
              "description": "Pixelbreite der Originaldatei.",
              "source": "product_feed",
              "validation": {
                "min": 1
              }
            },
            "height": {
              "type": "integer",
              "required": false,
              "description": "Pixelhöhe der Originaldatei.",
              "source": "product_feed",
              "validation": {
                "min": 1
              }
            },
            "asset_id": {
              "type": "string",
              "required": false,
              "description": "Asset-Referenz.",
              "source": "product_feed"
            },
            "rights_status": {
              "type": "enum",
              "required": false,
              "description": "Nutzungsfreigabe.",
              "source": "product_feed",
              "values": [
                "approved",
                "pending",
                "unknown",
                "rejected"
              ],
              "default": "unknown"
            }
          }
        },
        "price": {
          "type": "price",
          "required": true,
          "description": "Preis (wird mit * dargestellt).",
          "source": "product_feed"
        },
        "old_price": {
          "type": "price",
          "required": false,
          "description": "Streichpreis – erscheint als 'UVP / Katalogpreis' durchgestrichen.",
          "source": "product_feed"
        },
        "currency": {
          "type": "string",
          "required": false,
          "description": "Währung (Standard EUR).",
          "source": "product_feed"
        }
      }
    },
    "image": {
      "type": "image",
      "required": false,
      "description": "Optional eigenes Bild (Freisteller/Szene) – \"{{assets.imgXX}}\".",
      "source": "asset_pipeline",
      "validation": {
        "image_requirement": "image"
      },
      "fields": {
        "url": {
          "type": "url",
          "required": true,
          "description": "Absolute HTTPS-URL (cairo.de / news.cairo.de).",
          "source": "asset_pipeline",
          "validation": {
            "https_only": true
          }
        },
        "alt": {
          "type": "string",
          "required": true,
          "description": "Alternativtext. Bei Grafiken mit eingebranntem Text MUSS der Bildtext enthalten sein.",
          "source": "ai_agent",
          "validation": {
            "min_length": 3,
            "max_length": 140
          }
        },
        "width": {
          "type": "integer",
          "required": false,
          "description": "Pixelbreite der Originaldatei.",
          "source": "asset_pipeline",
          "validation": {
            "min": 1
          }
        },
        "height": {
          "type": "integer",
          "required": false,
          "description": "Pixelhöhe der Originaldatei.",
          "source": "asset_pipeline",
          "validation": {
            "min": 1
          }
        },
        "asset_id": {
          "type": "string",
          "required": false,
          "description": "Asset-Referenz.",
          "source": "asset_pipeline"
        },
        "rights_status": {
          "type": "enum",
          "required": false,
          "description": "Nutzungsfreigabe.",
          "source": "asset_pipeline",
          "values": [
            "approved",
            "pending",
            "unknown",
            "rejected"
          ],
          "default": "unknown"
        }
      }
    },
    "image_width": {
      "type": "enum",
      "required": false,
      "description": "600 = volle Breite (Standard), 400 = kleiner bei Hochformat.",
      "source": "ai_agent",
      "values": [
        "600",
        "400"
      ],
      "default": "600"
    },
    "headline": {
      "type": "string",
      "required": true,
      "description": "Kurzer Modellname.",
      "source": "ai_agent",
      "validation": {
        "min_length": 2,
        "max_length": 32
      }
    },
    "subtitle": {
      "type": "string",
      "required": false,
      "description": "Produktart/Variante ('4 verschiedene Farben', 'Leuchte, Ø 40–80 cm').",
      "source": "ai_agent",
      "validation": {
        "max_length": 45
      }
    },
    "description": {
      "type": "rich_text",
      "required": false,
      "description": "Optional 1–2 Sätze.",
      "source": "ai_agent",
      "validation": {
        "max_length": 250
      }
    },
    "price_prefix": {
      "type": "enum",
      "required": false,
      "description": "'ab' bei mehreren Größen/Ausführungen.",
      "source": "ai_agent",
      "values": [
        "ab"
      ]
    },
    "link_url": {
      "type": "url",
      "required": false,
      "description": "Ziel, falls kein product.",
      "source": "campaign_brief",
      "validation": {
        "https_only": true
      }
    },
    "cta_label": {
      "type": "string",
      "required": false,
      "description": "Buttontext (Standard 'Zum Produkt').",
      "source": "ai_agent",
      "validation": {
        "max_length": 25
      }
    },
    "button_color": {
      "type": "enum",
      "required": false,
      "description": "Buttonfarbe (Kampagnenfarbe).",
      "source": "ai_agent",
      "values": [
        "aubergine",
        "altrosa",
        "blush",
        "hellblau",
        "grau",
        "anthrazit"
      ],
      "default": "aubergine"
    },
    "spacing_top": {
      "type": "enum",
      "required": false,
      "description": "Abstand oben. none = 0, s = 15px, m = 25px (Standard zwischen Bausteinen), l = 50px.",
      "source": "static_default",
      "values": [
        "none",
        "s",
        "m",
        "l"
      ],
      "default": "m"
    }
  },
  "image_requirements": [
    {
      "key": "feature_image",
      "field": "product.image",
      "image_type": "product",
      "aspect_ratio": null,
      "display_width": 600,
      "min_width": 600,
      "formats": [
        "jpg",
        "jpeg",
        "png"
      ],
      "alt_required": true,
      "focus": "Freisteller oder ruhige Szene, querformatig",
      "rendering": "img"
    }
  ],
  "layout": {
    "desktop_columns": 1,
    "mobile_columns": 1,
    "full_width": true,
    "uses_background_image": false,
    "approx_height_px": {
      "desktop": 560,
      "mobile": 560
    }
  },
  "constraints": [
    "needs_product_or_image"
  ],
  "exclusion_criteria": [],
  "compatibility": {
    "recommended_after": [
      "CA_PRODUCT_CARDS_01",
      "CA_TEXT_01"
    ],
    "recommended_before": [
      "CA_PRODUCT_CARDS_01",
      "CA_TILES_01"
    ],
    "avoid_adjacent": [],
    "hard_dependencies": []
  },
  "ai_hints": {
    "when_to_use": "Zwischen Kartenblöcken als Ruhepol oder für ein Produkt mit querformatigem Freisteller.",
    "when_not_to_use": "Bei Hochkant-Bildern ohne image_width 400.",
    "content_guidelines": "headline = Modellname, subtitle = Variante/Größe."
  }
}
