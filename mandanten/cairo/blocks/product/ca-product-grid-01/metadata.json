{
  "id": "CA_PRODUCT_GRID_01",
  "brand": "cairo",
  "name": "Produktraster – 2 Spalten, 2 oder 4 Produkte",
  "version": "1.0.0",
  "category": "product",
  "status": "stable",
  "purpose": "Mehrere gleichwertige Produkte kompakt zeigen.",
  "description": "2 Spalten à 288px (24px Abstand), 1 oder 2 Reihen: Bild, Modellname (21px fett), Produktart; layout panel: Farbfläche, Preis und Button rechtsbündig (Slim Irony, Saarinen Tulip) · layout plain: ohne Fläche, alles zentriert (Componibili im Singles-Day-Newsletter).",
  "use_cases": [
    "product_recommendations",
    "sale_products"
  ],
  "campaign_types": [
    "seasonal_campaign",
    "sale",
    "voucher",
    "gift_guide",
    "new_arrivals",
    "product_launch",
    "collection_spotlight",
    "black_week",
    "contest",
    "free_gift",
    "free_shipping",
    "product_recommendations",
    "brand_story"
  ],
  "position": {
    "slot": "body",
    "unique": false,
    "max_per_newsletter": 3
  },
  "fields": {
    "heading_bold": {
      "type": "string",
      "required": false,
      "description": "Optionale Abschnittsüberschrift, fetter Teil (26px), z. B. 'ausgewählte Kategorien' oder 'HERBST30 –'.",
      "source": "ai_agent",
      "validation": {
        "max_length": 40
      }
    },
    "heading_light": {
      "type": "string",
      "required": false,
      "description": "Optionaler dünner Teil der Abschnittsüberschrift, z. B. 'Für Sie' oder 'Inspirationen bis 250 €'.",
      "source": "ai_agent",
      "validation": {
        "max_length": 40
      }
    },
    "heading_bold_first": {
      "type": "boolean",
      "required": false,
      "description": "true = fetter Teil zuerst ('HERBST30 – Inspirationen bis 250 €'), false = dünner Teil zuerst ('Für Sie ausgewählte Kategorien').",
      "source": "ai_agent",
      "default": true
    },
    "heading_color": {
      "type": "enum",
      "required": false,
      "description": "Farbe der Abschnittsüberschrift.",
      "source": "ai_agent",
      "values": [
        "aubergine",
        "schwarz",
        "altrosa",
        "anthrazit"
      ],
      "default": "aubergine"
    },
    "items": {
      "type": "array",
      "required": true,
      "description": "2 oder 4 Produkte.",
      "source": "ai_agent",
      "validation": {
        "min_items": 2,
        "max_items": 4,
        "allowed_counts": [
          2,
          4
        ]
      },
      "item_fields": {
        "product": {
          "type": "object",
          "required": false,
          "description": "Produkt aus dem Feed als Platzhalter \"{{products.pXX}}\" (liefert Bild, Link, Preis, Streichpreis). Ohne Produkt (PRODUKTE_ZEIGEN = nein): image + link_url setzen.",
          "source": "product_feed",
          "fields": {
            "sku": {
              "type": "string",
              "required": false,
              "description": "Artikelnummer.",
              "source": "product_feed",
              "validation": {
                "max_length": 64
              }
            },
            "name": {
              "type": "string",
              "required": false,
              "description": "Feed-Titel (wird nicht angezeigt – Anzeige über headline).",
              "source": "product_feed"
            },
            "product_url": {
              "type": "url",
              "required": true,
              "description": "Produktdetailseite.",
              "source": "product_feed",
              "validation": {
                "https_only": true
              }
            },
            "image": {
              "type": "image",
              "required": true,
              "description": "Produktbild aus dem Feed.",
              "source": "product_feed",
              "validation": {
                "image_requirement": "product_image"
              },
              "fields": {
                "url": {
                  "type": "url",
                  "required": true,
                  "description": "Absolute HTTPS-URL (cairo.de / news.cairo.de).",
                  "source": "product_feed",
                  "validation": {
                    "https_only": true
                  }
                },
                "alt": {
                  "type": "string",
                  "required": true,
                  "description": "Alternativtext. Bei Grafiken mit eingebranntem Text MUSS der Bildtext enthalten sein.",
                  "source": "ai_agent",
                  "validation": {
                    "min_length": 3,
                    "max_length": 140
                  }
                },
                "width": {
                  "type": "integer",
                  "required": false,
                  "description": "Pixelbreite der Originaldatei.",
                  "source": "product_feed",
                  "validation": {
                    "min": 1
                  }
                },
                "height": {
                  "type": "integer",
                  "required": false,
                  "description": "Pixelhöhe der Originaldatei.",
                  "source": "product_feed",
                  "validation": {
                    "min": 1
                  }
                },
                "asset_id": {
                  "type": "string",
                  "required": false,
                  "description": "Asset-Referenz.",
                  "source": "product_feed"
                },
                "rights_status": {
                  "type": "enum",
                  "required": false,
                  "description": "Nutzungsfreigabe.",
                  "source": "product_feed",
                  "values": [
                    "approved",
                    "pending",
                    "unknown",
                    "rejected"
                  ],
                  "default": "unknown"
                }
              }
            },
            "price": {
              "type": "price",
              "required": true,
              "description": "Preis (wird mit * dargestellt).",
              "source": "product_feed"
            },
            "old_price": {
              "type": "price",
              "required": false,
              "description": "Streichpreis – erscheint als 'UVP / Katalogpreis' durchgestrichen.",
              "source": "product_feed"
            },
            "currency": {
              "type": "string",
              "required": false,
              "description": "Währung (Standard EUR).",
              "source": "product_feed"
            }
          }
        },
        "image": {
          "type": "image",
          "required": false,
          "description": "Optional: eigenes Bild (Wohnszene) statt des Feed-Bilds – \"{{assets.imgXX}}\". Pflicht, wenn kein product.",
          "source": "asset_pipeline",
          "validation": {
            "image_requirement": "image"
          },
          "fields": {
            "url": {
              "type": "url",
              "required": true,
              "description": "Absolute HTTPS-URL (cairo.de / news.cairo.de).",
              "source": "asset_pipeline",
              "validation": {
                "https_only": true
              }
            },
            "alt": {
              "type": "string",
              "required": true,
              "description": "Alternativtext. Bei Grafiken mit eingebranntem Text MUSS der Bildtext enthalten sein.",
              "source": "ai_agent",
              "validation": {
                "min_length": 3,
                "max_length": 140
              }
            },
            "width": {
              "type": "integer",
              "required": false,
              "description": "Pixelbreite der Originaldatei.",
              "source": "asset_pipeline",
              "validation": {
                "min": 1
              }
            },
            "height": {
              "type": "integer",
              "required": false,
              "description": "Pixelhöhe der Originaldatei.",
              "source": "asset_pipeline",
              "validation": {
                "min": 1
              }
            },
            "asset_id": {
              "type": "string",
              "required": false,
              "description": "Asset-Referenz.",
              "source": "asset_pipeline"
            },
            "rights_status": {
              "type": "enum",
              "required": false,
              "description": "Nutzungsfreigabe.",
              "source": "asset_pipeline",
              "values": [
                "approved",
                "pending",
                "unknown",
                "rejected"
              ],
              "default": "unknown"
            }
          }
        },
        "headline": {
          "type": "string",
          "required": true,
          "description": "Kurzer Modellname (21px fett), z. B. 'Componibili', 'Barcelona', 'Vipp 430 Studio Desk'. NICHT den Feed-Titel.",
          "source": "ai_agent",
          "validation": {
            "min_length": 2,
            "max_length": 24
          }
        },
        "subtitle": {
          "type": "string",
          "required": false,
          "description": "Produktart (18px), z. B. 'Container', 'Lounge Sessel mit Hocker'.",
          "source": "ai_agent",
          "validation": {
            "max_length": 28
          }
        },
        "price_prefix": {
          "type": "enum",
          "required": false,
          "description": "'ab' vor dem Preis, nur bei mehreren Größen/Ausführungen.",
          "source": "ai_agent",
          "values": [
            "ab"
          ]
        },
        "link_url": {
          "type": "url",
          "required": false,
          "description": "Ziel, falls kein product (sonst Produkt-URL).",
          "source": "campaign_brief",
          "validation": {
            "https_only": true
          }
        },
        "cta_label": {
          "type": "string",
          "required": false,
          "description": "Buttontext (Standard 'Zum Produkt').",
          "source": "ai_agent",
          "validation": {
            "max_length": 25
          }
        }
      }
    },
    "layout": {
      "type": "enum",
      "required": false,
      "description": "panel = Farbfläche (Standard), plain = zentriert ohne Fläche.",
      "source": "ai_agent",
      "values": [
        "panel",
        "plain"
      ],
      "default": "panel"
    },
    "panel_color": {
      "type": "enum",
      "required": false,
      "description": "Farbfläche (Kampagnenfarbe). Im ganzen Newsletter möglichst dieselbe Farbe.",
      "source": "ai_agent",
      "values": [
        "aubergine",
        "altrosa",
        "blush",
        "hellblau",
        "grau",
        "anthrazit"
      ],
      "default": "aubergine"
    },
    "link_url": {
      "type": "url",
      "required": false,
      "description": "Fallback-Ziel.",
      "source": "campaign_brief",
      "validation": {
        "https_only": true
      }
    },
    "spacing_top": {
      "type": "enum",
      "required": false,
      "description": "Abstand oben. none = 0, s = 15px, m = 25px (Standard zwischen Bausteinen), l = 50px.",
      "source": "static_default",
      "values": [
        "none",
        "s",
        "m",
        "l"
      ],
      "default": "m"
    }
  },
  "image_requirements": [
    {
      "key": "grid_image",
      "field": "items[].product.image",
      "image_type": "product",
      "aspect_ratio": "1:1",
      "display_width": 288,
      "min_width": 576,
      "formats": [
        "jpg",
        "jpeg",
        "png"
      ],
      "alt_required": true,
      "focus": "Gleiches Seitenverhältnis innerhalb einer Reihe",
      "rendering": "img"
    }
  ],
  "layout": {
    "desktop_columns": 2,
    "mobile_columns": 1,
    "full_width": true,
    "uses_background_image": false,
    "approx_height_px": {
      "desktop": 520,
      "mobile": 1000
    }
  },
  "constraints": [
    "each_item_needs_product_or_image"
  ],
  "exclusion_criteria": [],
  "compatibility": {
    "recommended_after": [
      "CA_PRODUCT_CARDS_01",
      "CA_BANNER_01",
      "CA_TEXT_01"
    ],
    "recommended_before": [
      "CA_CODE_BANNER_01",
      "CA_TILES_01"
    ],
    "avoid_adjacent": [],
    "hard_dependencies": []
  },
  "ai_hints": {
    "when_to_use": "2 oder 4 Produkte gleichwertig, z. B. zwei Varianten einer Serie.",
    "when_not_to_use": "Einzelnes Produkt → CA_PRODUCT_FEATURE_01 oder CA_PRODUCT_CARDS_01.",
    "content_guidelines": "Produkte mit ähnlich hohen Bildern kombinieren. Namen kurz halten, damit die Kacheln gleich hoch bleiben."
  }
}
