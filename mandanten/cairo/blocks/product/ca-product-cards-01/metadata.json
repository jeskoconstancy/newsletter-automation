{
  "id": "CA_PRODUCT_CARDS_01",
  "brand": "cairo",
  "name": "Produktkarten – Bild | Text, 1–3 untereinander",
  "version": "1.0.0",
  "category": "product",
  "status": "stable",
  "purpose": "Einzelne Produkte ausführlich vorstellen – das zentrale Cairo-Modul.",
  "description": "1–3 Karten untereinander (25px Abstand): Bild 300px | Textspalte mit Modellname (21px fett), Produktart (18px), 3 Stichpunkte (•) oder Beschreibung, 'UVP / Katalogpreis' durchgestrichen, Preis (21px fett, optional 'ab', mit *), Button 'Zum Produkt'. Bildseite wechselt automatisch. layout panel = Farbfläche (Aubergine/Altrosa/Blush mit pinkem bzw. dunklem Button), plain = auf Weiß ohne Fläche.",
  "use_cases": [
    "product_feature",
    "sale_products",
    "new_products"
  ],
  "campaign_types": [
    "seasonal_campaign",
    "sale",
    "voucher",
    "gift_guide",
    "new_arrivals",
    "product_launch",
    "collection_spotlight",
    "black_week",
    "contest",
    "free_gift",
    "free_shipping",
    "product_recommendations",
    "brand_story"
  ],
  "position": {
    "slot": "body",
    "unique": false,
    "max_per_newsletter": 3
  },
  "fields": {
    "heading_bold": {
      "type": "string",
      "required": false,
      "description": "Optionale Abschnittsüberschrift, fetter Teil (26px), z. B. 'ausgewählte Kategorien' oder 'HERBST30 –'.",
      "source": "ai_agent",
      "validation": {
        "max_length": 40
      }
    },
    "heading_light": {
      "type": "string",
      "required": false,
      "description": "Optionaler dünner Teil der Abschnittsüberschrift, z. B. 'Für Sie' oder 'Inspirationen bis 250 €'.",
      "source": "ai_agent",
      "validation": {
        "max_length": 40
      }
    },
    "heading_bold_first": {
      "type": "boolean",
      "required": false,
      "description": "true = fetter Teil zuerst ('HERBST30 – Inspirationen bis 250 €'), false = dünner Teil zuerst ('Für Sie ausgewählte Kategorien').",
      "source": "ai_agent",
      "default": true
    },
    "heading_color": {
      "type": "enum",
      "required": false,
      "description": "Farbe der Abschnittsüberschrift.",
      "source": "ai_agent",
      "values": [
        "aubergine",
        "schwarz",
        "altrosa",
        "anthrazit"
      ],
      "default": "aubergine"
    },
    "cards": {
      "type": "array",
      "required": true,
      "description": "1–3 Karten.",
      "source": "ai_agent",
      "validation": {
        "min_items": 1,
        "max_items": 3
      },
      "item_fields": {
        "product": {
          "type": "object",
          "required": false,
          "description": "Produkt aus dem Feed als Platzhalter \"{{products.pXX}}\" (liefert Bild, Link, Preis, Streichpreis). Ohne Produkt (PRODUKTE_ZEIGEN = nein): image + link_url setzen.",
          "source": "product_feed",
          "fields": {
            "sku": {
              "type": "string",
              "required": false,
              "description": "Artikelnummer.",
              "source": "product_feed",
              "validation": {
                "max_length": 64
              }
            },
            "name": {
              "type": "string",
              "required": false,
              "description": "Feed-Titel (wird nicht angezeigt – Anzeige über headline).",
              "source": "product_feed"
            },
            "product_url": {
              "type": "url",
              "required": true,
              "description": "Produktdetailseite.",
              "source": "product_feed",
              "validation": {
                "https_only": true
              }
            },
            "image": {
              "type": "image",
              "required": true,
              "description": "Produktbild aus dem Feed.",
              "source": "product_feed",
              "validation": {
                "image_requirement": "product_image"
              },
              "fields": {
                "url": {
                  "type": "url",
                  "required": true,
                  "description": "Absolute HTTPS-URL (cairo.de / news.cairo.de).",
                  "source": "product_feed",
                  "validation": {
                    "https_only": true
                  }
                },
                "alt": {
                  "type": "string",
                  "required": true,
                  "description": "Alternativtext. Bei Grafiken mit eingebranntem Text MUSS der Bildtext enthalten sein.",
                  "source": "ai_agent",
                  "validation": {
                    "min_length": 3,
                    "max_length": 140
                  }
                },
                "width": {
                  "type": "integer",
                  "required": false,
                  "description": "Pixelbreite der Originaldatei.",
                  "source": "product_feed",
                  "validation": {
                    "min": 1
                  }
                },
                "height": {
                  "type": "integer",
                  "required": false,
                  "description": "Pixelhöhe der Originaldatei.",
                  "source": "product_feed",
                  "validation": {
                    "min": 1
                  }
                },
                "asset_id": {
                  "type": "string",
                  "required": false,
                  "description": "Asset-Referenz.",
                  "source": "product_feed"
                },
                "rights_status": {
                  "type": "enum",
                  "required": false,
                  "description": "Nutzungsfreigabe.",
                  "source": "product_feed",
                  "values": [
                    "approved",
                    "pending",
                    "unknown",
                    "rejected"
                  ],
                  "default": "unknown"
                }
              }
            },
            "price": {
              "type": "price",
              "required": true,
              "description": "Preis (wird mit * dargestellt).",
              "source": "product_feed"
            },
            "old_price": {
              "type": "price",
              "required": false,
              "description": "Streichpreis – erscheint als 'UVP / Katalogpreis' durchgestrichen.",
              "source": "product_feed"
            },
            "currency": {
              "type": "string",
              "required": false,
              "description": "Währung (Standard EUR).",
              "source": "product_feed"
            }
          }
        },
        "image": {
          "type": "image",
          "required": false,
          "description": "Optional: eigenes Bild (Wohnszene) statt des Feed-Bilds – \"{{assets.imgXX}}\". Pflicht, wenn kein product.",
          "source": "asset_pipeline",
          "validation": {
            "image_requirement": "image"
          },
          "fields": {
            "url": {
              "type": "url",
              "required": true,
              "description": "Absolute HTTPS-URL (cairo.de / news.cairo.de).",
              "source": "asset_pipeline",
              "validation": {
                "https_only": true
              }
            },
            "alt": {
              "type": "string",
              "required": true,
              "description": "Alternativtext. Bei Grafiken mit eingebranntem Text MUSS der Bildtext enthalten sein.",
              "source": "ai_agent",
              "validation": {
                "min_length": 3,
                "max_length": 140
              }
            },
            "width": {
              "type": "integer",
              "required": false,
              "description": "Pixelbreite der Originaldatei.",
              "source": "asset_pipeline",
              "validation": {
                "min": 1
              }
            },
            "height": {
              "type": "integer",
              "required": false,
              "description": "Pixelhöhe der Originaldatei.",
              "source": "asset_pipeline",
              "validation": {
                "min": 1
              }
            },
            "asset_id": {
              "type": "string",
              "required": false,
              "description": "Asset-Referenz.",
              "source": "asset_pipeline"
            },
            "rights_status": {
              "type": "enum",
              "required": false,
              "description": "Nutzungsfreigabe.",
              "source": "asset_pipeline",
              "values": [
                "approved",
                "pending",
                "unknown",
                "rejected"
              ],
              "default": "unknown"
            }
          }
        },
        "headline": {
          "type": "string",
          "required": true,
          "description": "Kurzer Modellname (21px fett), z. B. 'Componibili', 'Barcelona', 'Vipp 430 Studio Desk'. NICHT den Feed-Titel.",
          "source": "ai_agent",
          "validation": {
            "min_length": 2,
            "max_length": 32
          }
        },
        "subtitle": {
          "type": "string",
          "required": false,
          "description": "Produktart (18px), z. B. 'Container', 'Lounge Sessel mit Hocker'.",
          "source": "ai_agent",
          "validation": {
            "max_length": 40
          }
        },
        "bullets": {
          "type": "paragraphs",
          "required": false,
          "description": "Genau 3 Stichpunkte, je 2–5 Wörter, klein beginnend, ohne Punkt.",
          "source": "ai_agent",
          "validation": {
            "max_items": 3,
            "item_max_length": 40
          }
        },
        "description": {
          "type": "rich_text",
          "required": false,
          "description": "Alternative zu bullets: 3–5 Sätze Beschreibung (für layout plain, ein Produkt).",
          "source": "ai_agent",
          "validation": {
            "max_length": 550
          }
        },
        "price_prefix": {
          "type": "enum",
          "required": false,
          "description": "'ab' vor dem Preis, nur bei mehreren Größen/Ausführungen.",
          "source": "ai_agent",
          "values": [
            "ab"
          ]
        },
        "link_url": {
          "type": "url",
          "required": false,
          "description": "Ziel, falls kein product (sonst Produkt-URL).",
          "source": "campaign_brief",
          "validation": {
            "https_only": true
          }
        },
        "cta_label": {
          "type": "string",
          "required": false,
          "description": "Buttontext (Standard 'Zum Produkt').",
          "source": "ai_agent",
          "validation": {
            "max_length": 25
          }
        }
      }
    },
    "layout": {
      "type": "enum",
      "required": false,
      "description": "panel = Farbfläche (Standard), plain = ohne Fläche auf Weiß (ruhiger, gut für 'description').",
      "source": "ai_agent",
      "values": [
        "panel",
        "plain"
      ],
      "default": "panel"
    },
    "panel_color": {
      "type": "enum",
      "required": false,
      "description": "Farbfläche (Kampagnenfarbe). Im ganzen Newsletter möglichst dieselbe Farbe.",
      "source": "ai_agent",
      "values": [
        "aubergine",
        "altrosa",
        "blush",
        "hellblau",
        "grau",
        "anthrazit"
      ],
      "default": "aubergine"
    },
    "first_image_side": {
      "type": "enum",
      "required": false,
      "description": "Bildseite der ersten Karte; danach automatisch abwechselnd.",
      "source": "ai_agent",
      "values": [
        "left",
        "right"
      ],
      "default": "left"
    },
    "link_url": {
      "type": "url",
      "required": false,
      "description": "Fallback-Ziel für Karten ohne eigenen Link (Standard: Landingpage).",
      "source": "campaign_brief",
      "validation": {
        "https_only": true
      }
    },
    "spacing_top": {
      "type": "enum",
      "required": false,
      "description": "Abstand oben. none = 0, s = 15px, m = 25px (Standard zwischen Bausteinen), l = 50px.",
      "source": "static_default",
      "values": [
        "none",
        "s",
        "m",
        "l"
      ],
      "default": "m"
    }
  },
  "image_requirements": [
    {
      "key": "card_image",
      "field": "cards[].image",
      "image_type": "lifestyle",
      "aspect_ratio": null,
      "display_width": 300,
      "min_width": 600,
      "formats": [
        "jpg",
        "jpeg",
        "png"
      ],
      "alt_required": true,
      "focus": "Wohnszene oder Produkt im Raum, ca. quadratisch bis 6:5",
      "rendering": "img"
    },
    {
      "key": "card_product_image",
      "field": "cards[].product.image",
      "image_type": "product",
      "aspect_ratio": null,
      "display_width": 300,
      "min_width": 600,
      "formats": [
        "jpg",
        "jpeg",
        "png"
      ],
      "alt_required": true,
      "rendering": "img"
    }
  ],
  "layout": {
    "desktop_columns": 2,
    "mobile_columns": 1,
    "full_width": true,
    "uses_background_image": false,
    "approx_height_px": {
      "desktop": 300,
      "mobile": 650
    }
  },
  "constraints": [
    "each_card_needs_product_or_image"
  ],
  "exclusion_criteria": [
    "Mehr als 3 Produkte → zusätzlich CA_PRODUCT_GRID_01 oder CA_TILES_01."
  ],
  "compatibility": {
    "recommended_after": [
      "CA_HERO_01",
      "CA_TEXT_01",
      "CA_BANNER_01",
      "CA_CODE_BANNER_01"
    ],
    "recommended_before": [
      "CA_TILES_01",
      "CA_PRODUCT_GRID_01",
      "CA_CODE_BANNER_01"
    ],
    "avoid_adjacent": [],
    "hard_dependencies": []
  },
  "ai_hints": {
    "when_to_use": "Für die wichtigsten 1–3 Produkte eines Abschnitts.",
    "when_not_to_use": "Ohne Bild (weder product noch image).",
    "content_guidelines": "headline = Modellname, subtitle = Produktart, bullets = 3 konkrete Merkmale. Jede Karte braucht product ODER image (+ link_url).",
    "variant_selection": {
      "black_week": {
        "panel_color": "anthrazit"
      },
      "brand_story": {
        "layout": "plain"
      }
    }
  }
}
