{{!-- CA_PRODUCT_CARDS_01 · 1–3 Produktkarten untereinander: Bild 300px | Text (Modellname fett, Produktart, 3 Stichpunkte oder Beschreibung, UVP durchgestrichen, Preis, Button). Bildseite wechselt automatisch (first_image_side = erste Karte).
     layout panel = Farbfläche in der Kampagnenfarbe · plain = ohne Fläche auf Weiß. Mobil: Bild oben, Text darunter. --}}
{{#if (spacing d.spacing_top)}}{{> ca-gap h=(spacing d.spacing_top)}}{{/if}}
{{#if (or d.heading_bold d.heading_light)}}{{> ca-heading bold=d.heading_bold light=d.heading_light bold_first=d.heading_bold_first color=(lookup t.heading_colors d.heading_color)}}{{/if}}
{{#with (lookup t.palette (concat d.panel_color (pick d.layout "plain=_plain" "")))}}
{{#each ../d.cards}}
<mj-section padding="0"{{#if (eq ../../d.layout "panel")}} background-color="{{../bg}}"{{/if}}{{#unless (eq (pick @index "1=b" "a") (pick ../../d.first_image_side "right=b" "a"))}} direction="rtl"{{/unless}} css-class="ca-card">
  <mj-column width="50%" vertical-align="middle">
    <mj-image src="{{asset (fallback image.url product.image.url)}}" alt="{{fallback image.alt (fallback product.image.alt headline)}}" title="{{headline}}" href="{{link (fallback product.product_url (fallback link_url ../../d.link_url))}}" width="300px" fluid-on-mobile="true" />
  </mj-column>
  <mj-column width="50%" vertical-align="middle" padding="{{#if (eq ../../d.layout "panel")}}20px 24px{{else}}10px 0 10px 24px{{/if}}" css-class="ca-card-text">
    <mj-text color="{{../text}}">
      <div style="font-size:21px;line-height:25px;font-weight:700;"><a href="{{link (fallback product.product_url (fallback link_url ../../d.link_url))}}" style="color:{{../text}};text-decoration:none;">{{headline}}</a></div>
      {{#if subtitle}}<div style="font-size:18px;line-height:22px;">{{subtitle}}</div>{{/if}}
      {{#if bullets}}<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin-top:12px;">{{#each bullets}}<tr><td valign="top" style="font-size:16px;line-height:26px;color:{{../../text}};padding-right:10px;">&#8226;</td><td style="font-size:16px;line-height:26px;color:{{../../text}};">{{rt this}}</td></tr>{{/each}}</table>{{/if}}
      {{#if description}}<p style="margin:12px 0 0;font-size:16px;line-height:23px;">{{rt description}}</p>{{/if}}
      {{#if product.price}}<div style="margin-top:15px;">{{> ca-price p=product prefix=price_prefix color=../text muted=../muted t=../../t}}</div>{{/if}}
    </mj-text>
    {{> ca-button label=(fallback cta_label ../../t.labels.product_cta) url=(fallback product.product_url (fallback link_url ../../d.link_url)) bg=../button color=../button_text align="left" padding="18px 0 0"}}
  </mj-column>
</mj-section>
{{#unless @last}}{{> ca-gap h=25}}{{/unless}}
{{/each}}
{{/with}}
