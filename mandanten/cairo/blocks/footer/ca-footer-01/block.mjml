{{!-- CA_FOOTER_01 · B2B-Hinweis + Preishinweis (*) · graue Fläche (#f2f2f2): links CAIRO-Logo, Kontakt (Hotline, Fax, E-Mail), Firmenanschrift · rechts Trusted-Shops-Siegel, 'Folgen Sie uns' mit Instagram/Pinterest, Links Vorteile/Impressum/Datenschutz/Abbestellen · optional Empfängerzeile · optional Aktionsbedingungen (**) als Kleingedrucktes darunter. --}}
<mj-section padding="25px 0 20px" css-class="ca-legal-note">
  <mj-column>
    <mj-text css-class="ca-pad">{{d.legal.b2b_note}}{{#if d.show_price_note}}<br />{{d.legal.price_note}}{{/if}}</mj-text>
  </mj-column>
</mj-section>
<mj-section background-color="{{t.color.footer_background}}" padding="20px 12px" css-class="ca-footer">
  <mj-column width="50%" padding="0 12px" css-class="ca-fcol">
    <mj-image src="{{asset d.footer_logo.url}}" alt="{{d.footer_logo.alt}}" title="{{d.footer_logo.alt}}" width="{{d.footer_logo.width}}px" align="left" href="{{link d.shop_url}}" />
    <mj-text padding="36px 0 0" line-height="22px" color="{{t.color.footer_text}}">
      <p style="margin:0;"><strong>Kontakt</strong><br />Hotline<br /><a href="tel:{{d.contact.hotline}}" style="color:{{t.color.footer_text}};text-decoration:none;">{{d.contact.hotline}}</a>{{#if d.contact.fax}}<br />Fax {{d.contact.fax}}{{/if}}<br /><a href="mailto:{{d.contact.email}}" style="color:{{t.color.footer_text}};text-decoration:none;">{{d.contact.email}}</a></p>
      <p style="margin:16px 0 0;"><strong>{{#each d.legal.company_lines}}{{this}}{{#unless @last}}<br />{{/unless}}{{/each}}</strong><br />{{#each d.legal.address_lines}}{{this}}{{#unless @last}}<br />{{/unless}}{{/each}}</p>
    </mj-text>
  </mj-column>
  <mj-column width="50%" padding="0 12px" css-class="ca-fcol">
    {{#if d.trust_seal.url}}<mj-image src="{{asset d.trust_seal.url}}" alt="{{d.trust_seal.alt}}" title="{{d.trust_seal.alt}}" width="{{d.trust_seal.width}}px" align="left"{{#if d.trust_seal.link_url}} href="{{link d.trust_seal.link_url}}"{{/if}} />{{/if}}
    <mj-text padding="36px 0 0" color="{{t.color.footer_text}}">
      <div style="font-size:21px;line-height:29px;font-weight:300;"><strong style="font-weight:700;">Folgen</strong> Sie uns:</div>
      <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin-top:6px;"><tr>{{#each d.social}}<td valign="middle" style="padding-right:20px;"><a href="{{link url}}" style="text-decoration:none;"><img src="{{asset icon}}" width="{{width}}" alt="{{alt}}" style="display:block;border:0;" /></a></td>{{/each}}</tr></table>
      <div style="margin-top:28px;font-size:16px;line-height:32px;">{{#each d.legal.links}}<a href="{{link url}}" style="color:{{../t.color.footer_link}};text-decoration:none;">{{label}}</a><br />{{/each}}<a href="{{d.unsubscribe_url}}" style="color:{{t.color.footer_link}};text-decoration:none;">{{d.legal.unsubscribe_label}}</a></div>
    </mj-text>
  </mj-column>
</mj-section>
{{#if d.recipient_email_tag}}
<mj-section padding="8px 0 0" css-class="ca-recipient">
  <mj-column>
    <mj-text font-size="14px" line-height="18px" color="{{t.color.recipient_text}}" css-class="ca-pad">Dieser Newsletter wurde gesendet an: {{d.recipient_email_tag}}</mj-text>
  </mj-column>
</mj-section>
{{/if}}
{{#if d.footnote}}
<mj-section padding="25px 0 0" css-class="ca-footnote">
  <mj-column>
    <mj-text font-size="14px" line-height="20px" css-class="ca-pad">{{rt d.footnote}}</mj-text>
  </mj-column>
</mj-section>
{{/if}}
<mj-section padding="0"><mj-column><mj-spacer height="30px" /></mj-column></mj-section>
