{
  "id": "CA_TEXT_01",
  "brand": "cairo",
  "name": "Textbaustein – zentriert oder links, optional Farbfläche",
  "version": "1.0.0",
  "category": "text",
  "status": "stable",
  "purpose": "Einleitung, Zwischentext oder Fazit mit optionaler Hervorhebung und Button.",
  "description": "Headline (21px oder 26px fett), Unterzeile, Absätze (16px/1.45), optional ein hervorgehobener Satz (21px fett) nach dem ersten Absatz (Singles Day: 'Nur heute übernehmen wir die Mehrwertsteuer.**'), Kleingedrucktes und Button. Auf Weiß (panel_color 'keine') oder in einer Farbfläche mit 48px Innenabstand.",
  "use_cases": [
    "intro",
    "interlude",
    "closing"
  ],
  "campaign_types": [
    "seasonal_campaign",
    "sale",
    "voucher",
    "gift_guide",
    "new_arrivals",
    "product_launch",
    "collection_spotlight",
    "black_week",
    "contest",
    "free_gift",
    "free_shipping",
    "product_recommendations",
    "brand_story"
  ],
  "position": {
    "slot": "body",
    "unique": false,
    "max_per_newsletter": 2
  },
  "fields": {
    "headline": {
      "type": "string",
      "required": false,
      "description": "Optionale Headline. Zeilenumbruch mit \\n.",
      "source": "ai_agent",
      "validation": {
        "max_length": 80,
        "recommended_max_length": 55
      }
    },
    "headline_size": {
      "type": "enum",
      "required": false,
      "description": "m = 21px (Standard), l = 26px.",
      "source": "ai_agent",
      "values": [
        "m",
        "l"
      ],
      "default": "m"
    },
    "subline": {
      "type": "string",
      "required": false,
      "description": "Optionale Unterzeile (18px).",
      "source": "ai_agent",
      "validation": {
        "max_length": 90
      }
    },
    "paragraphs": {
      "type": "paragraphs",
      "required": false,
      "description": "1–3 Absätze, Sie-Ansprache. Erlaubt <strong>, <em>, <br>.",
      "source": "ai_agent",
      "validation": {
        "max_items": 3,
        "item_max_length": 500,
        "total_max_length": 900
      }
    },
    "highlight": {
      "type": "rich_text",
      "required": false,
      "description": "Optional: Kernsatz fett und größer, steht nach dem ersten Absatz (z. B. das Angebot). Mit ** wenn Bedingungen im Footer stehen.",
      "source": "ai_agent",
      "validation": {
        "max_length": 90
      }
    },
    "align": {
      "type": "enum",
      "required": false,
      "description": "center (Standard, Einleitung) oder left.",
      "source": "ai_agent",
      "values": [
        "center",
        "left"
      ],
      "default": "center"
    },
    "panel_color": {
      "type": "enum",
      "required": false,
      "description": "'keine' = auf Weiß, schwarze Schrift (Standard). Sonst Farbfläche in der Kampagnenfarbe.",
      "source": "ai_agent",
      "values": [
        "aubergine",
        "altrosa",
        "blush",
        "hellblau",
        "grau",
        "anthrazit",
        "keine"
      ],
      "default": "keine"
    },
    "note": {
      "type": "string",
      "required": false,
      "description": "Kleingedrucktes (13px) unter dem Text, z. B. kurze Aktionsbedingung. Ausführliche Bedingungen gehören in CA_FOOTER_01.footnote.",
      "source": "campaign_brief",
      "validation": {
        "max_length": 300
      }
    },
    "cta_label": {
      "type": "string",
      "required": false,
      "description": "Buttontext ('Zur Aktion', 'Jetzt entdecken').",
      "source": "ai_agent",
      "validation": {
        "min_length": 3,
        "max_length": 30
      }
    },
    "cta_url": {
      "type": "url",
      "required": false,
      "description": "Ziel des Buttons. Ohne URL kein Button.",
      "source": "campaign_brief",
      "validation": {
        "https_only": true
      }
    },
    "spacing_top": {
      "type": "enum",
      "required": false,
      "description": "Abstand oben. none = 0, s = 15px, m = 25px (Standard zwischen Bausteinen), l = 50px.",
      "source": "static_default",
      "values": [
        "none",
        "s",
        "m",
        "l"
      ],
      "default": "m"
    }
  },
  "image_requirements": [],
  "layout": {
    "desktop_columns": 1,
    "mobile_columns": 1,
    "full_width": true,
    "uses_background_image": false,
    "approx_height_px": {
      "desktop": 260,
      "mobile": 380
    }
  },
  "constraints": [
    "requires_headline_or_paragraphs",
    "max_one_cta"
  ],
  "exclusion_criteria": [],
  "compatibility": {
    "recommended_after": [
      "CA_HERO_01",
      "CA_HEADER_01"
    ],
    "recommended_before": [
      "CA_PRODUCT_CARDS_01",
      "CA_PRODUCT_GRID_01",
      "CA_TILES_01"
    ],
    "avoid_adjacent": [],
    "hard_dependencies": []
  },
  "ai_hints": {
    "when_to_use": "Als Einleitung (role intro) nach einem Hero ohne Textfläche, oder als Fazit (role fazit).",
    "when_not_to_use": "Direkt nach einem CA_HERO_01 mit eigener Textfläche (doppelte Einleitung).",
    "content_guidelines": "Einleitung zentriert, 2 kurze Absätze + highlight + cta 'Zur Aktion'. Kurz, sachlich, ein Gedanke pro Absatz."
  }
}
