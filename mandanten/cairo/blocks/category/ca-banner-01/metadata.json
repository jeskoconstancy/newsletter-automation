{
  "id": "CA_BANNER_01",
  "brand": "cairo",
  "name": "Zwischenbanner – Grafik 600px",
  "version": "1.0.0",
  "category": "category",
  "status": "stable",
  "purpose": "Aktionsmotiv wiederholen oder neuen Abschnitt mit einer Grafik einleiten.",
  "description": "Bild 600px volle Breite, optional verlinkt (z. B. 'Mehrwertsteuer geschenkt – nur heute', Herbstaktion-Banner mit Codes, Wohnszene im Querformat).",
  "use_cases": [
    "section_opener",
    "repeat_offer"
  ],
  "campaign_types": [
    "seasonal_campaign",
    "sale",
    "voucher",
    "gift_guide",
    "new_arrivals",
    "product_launch",
    "collection_spotlight",
    "black_week",
    "contest",
    "free_gift",
    "free_shipping",
    "product_recommendations",
    "brand_story"
  ],
  "position": {
    "slot": "body",
    "unique": false,
    "max_per_newsletter": 2
  },
  "fields": {
    "image": {
      "type": "image",
      "required": true,
      "description": "Grafik oder Wohnszene im Querformat – \"{{assets.imgXX}}\". Bei Text im Bild: ALT = Bildtext.",
      "source": "asset_pipeline",
      "validation": {
        "image_requirement": "banner_image"
      },
      "fields": {
        "url": {
          "type": "url",
          "required": true,
          "description": "Absolute HTTPS-URL (cairo.de / news.cairo.de).",
          "source": "asset_pipeline",
          "validation": {
            "https_only": true
          }
        },
        "alt": {
          "type": "string",
          "required": true,
          "description": "Alternativtext. Bei Grafiken mit eingebranntem Text MUSS der Bildtext enthalten sein.",
          "source": "ai_agent",
          "validation": {
            "min_length": 3,
            "max_length": 140
          }
        },
        "width": {
          "type": "integer",
          "required": false,
          "description": "Pixelbreite der Originaldatei.",
          "source": "asset_pipeline",
          "validation": {
            "min": 1
          }
        },
        "height": {
          "type": "integer",
          "required": false,
          "description": "Pixelhöhe der Originaldatei.",
          "source": "asset_pipeline",
          "validation": {
            "min": 1
          }
        },
        "asset_id": {
          "type": "string",
          "required": false,
          "description": "Asset-Referenz.",
          "source": "asset_pipeline"
        },
        "rights_status": {
          "type": "enum",
          "required": false,
          "description": "Nutzungsfreigabe.",
          "source": "asset_pipeline",
          "values": [
            "approved",
            "pending",
            "unknown",
            "rejected"
          ],
          "default": "unknown"
        }
      }
    },
    "link_url": {
      "type": "url",
      "required": false,
      "description": "Ziel (Standard: Landingpage).",
      "source": "campaign_brief",
      "validation": {
        "https_only": true
      }
    },
    "spacing_top": {
      "type": "enum",
      "required": false,
      "description": "Abstand oben. none = 0, s = 15px, m = 25px (Standard zwischen Bausteinen), l = 50px.",
      "source": "static_default",
      "values": [
        "none",
        "s",
        "m",
        "l"
      ],
      "default": "m"
    }
  },
  "image_requirements": [
    {
      "key": "banner_image",
      "field": "image",
      "image_type": "promo_banner",
      "aspect_ratio": null,
      "display_width": 600,
      "min_width": 600,
      "formats": [
        "jpg",
        "jpeg",
        "png"
      ],
      "alt_required": true,
      "rendering": "img"
    }
  ],
  "layout": {
    "desktop_columns": 1,
    "mobile_columns": 1,
    "full_width": true,
    "uses_background_image": false,
    "approx_height_px": {
      "desktop": 200,
      "mobile": 120
    }
  },
  "constraints": [
    "requires_image"
  ],
  "exclusion_criteria": [],
  "compatibility": {
    "recommended_after": [
      "CA_TILES_01",
      "CA_PRODUCT_CARDS_01",
      "CA_CODE_BANNER_01"
    ],
    "recommended_before": [
      "CA_PRODUCT_CARDS_01",
      "CA_PRODUCT_GRID_01"
    ],
    "avoid_adjacent": [
      "CA_HERO_01"
    ],
    "hard_dependencies": []
  },
  "ai_hints": {
    "when_to_use": "Zweites Kampagnenbild oder querformatige Wohnszene, um einen neuen Abschnitt einzuleiten.",
    "when_not_to_use": "Direkt nach dem Hero.",
    "content_guidelines": "link_url = Landingpage."
  }
}
