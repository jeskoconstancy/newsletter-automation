{
  "id": "CA_TILES_01",
  "brand": "cairo",
  "name": "Kacheln – 3 nebeneinander mit Beschriftungsfeld",
  "version": "1.0.0",
  "category": "category",
  "status": "stable",
  "purpose": "Kategorien oder kleine Produkte/Zubehör als Bildkacheln anteasern.",
  "description": "3 oder 6 Kacheln à 184px (24px Abstand, auch mobil 3 nebeneinander): Bild, darunter Beschriftungsfeld in der Kachelfarbe mit Titel (fett) und optional Zusatzzeile. Referenz: 'Für Sie ausgesuchte Kategorien' (hellblau/blush) und Kaminzubehör 'Ashi/Kwadrat' (aubergine).",
  "use_cases": [
    "category_teaser",
    "accessories"
  ],
  "campaign_types": [
    "seasonal_campaign",
    "sale",
    "voucher",
    "gift_guide",
    "new_arrivals",
    "product_launch",
    "collection_spotlight",
    "black_week",
    "contest",
    "free_gift",
    "free_shipping",
    "product_recommendations",
    "brand_story"
  ],
  "position": {
    "slot": "body",
    "unique": false,
    "max_per_newsletter": 2
  },
  "fields": {
    "heading_bold": {
      "type": "string",
      "required": false,
      "description": "Optionale Abschnittsüberschrift, fetter Teil (26px), z. B. 'ausgewählte Kategorien' oder 'HERBST30 –'.",
      "source": "ai_agent",
      "validation": {
        "max_length": 40
      }
    },
    "heading_light": {
      "type": "string",
      "required": false,
      "description": "Optionaler dünner Teil der Abschnittsüberschrift, z. B. 'Für Sie' oder 'Inspirationen bis 250 €'.",
      "source": "ai_agent",
      "validation": {
        "max_length": 40
      }
    },
    "heading_bold_first": {
      "type": "boolean",
      "required": false,
      "description": "true = fetter Teil zuerst ('HERBST30 – Inspirationen bis 250 €'), false = dünner Teil zuerst ('Für Sie ausgewählte Kategorien').",
      "source": "ai_agent",
      "default": true
    },
    "heading_color": {
      "type": "enum",
      "required": false,
      "description": "Farbe der Abschnittsüberschrift.",
      "source": "ai_agent",
      "values": [
        "aubergine",
        "schwarz",
        "altrosa",
        "anthrazit"
      ],
      "default": "aubergine"
    },
    "tiles": {
      "type": "array",
      "required": true,
      "description": "3 oder 6 Kacheln.",
      "source": "ai_agent",
      "validation": {
        "min_items": 3,
        "max_items": 6,
        "allowed_counts": [
          3,
          6
        ]
      },
      "item_fields": {
        "image": {
          "type": "image",
          "required": false,
          "description": "Kachelbild – \"{{assets.imgXX}}\" (Kategorie-/Wohnszene) oder weglassen und product setzen.",
          "source": "asset_pipeline",
          "validation": {
            "image_requirement": "image"
          },
          "fields": {
            "url": {
              "type": "url",
              "required": true,
              "description": "Absolute HTTPS-URL (cairo.de / news.cairo.de).",
              "source": "asset_pipeline",
              "validation": {
                "https_only": true
              }
            },
            "alt": {
              "type": "string",
              "required": true,
              "description": "Alternativtext. Bei Grafiken mit eingebranntem Text MUSS der Bildtext enthalten sein.",
              "source": "ai_agent",
              "validation": {
                "min_length": 3,
                "max_length": 140
              }
            },
            "width": {
              "type": "integer",
              "required": false,
              "description": "Pixelbreite der Originaldatei.",
              "source": "asset_pipeline",
              "validation": {
                "min": 1
              }
            },
            "height": {
              "type": "integer",
              "required": false,
              "description": "Pixelhöhe der Originaldatei.",
              "source": "asset_pipeline",
              "validation": {
                "min": 1
              }
            },
            "asset_id": {
              "type": "string",
              "required": false,
              "description": "Asset-Referenz.",
              "source": "asset_pipeline"
            },
            "rights_status": {
              "type": "enum",
              "required": false,
              "description": "Nutzungsfreigabe.",
              "source": "asset_pipeline",
              "values": [
                "approved",
                "pending",
                "unknown",
                "rejected"
              ],
              "default": "unknown"
            }
          }
        },
        "product": {
          "type": "object",
          "required": false,
          "description": "Optional Produkt als \"{{products.pXX}}\" (Bild + Link).",
          "source": "product_feed",
          "fields": {
            "sku": {
              "type": "string",
              "required": false,
              "description": "Artikelnummer.",
              "source": "product_feed",
              "validation": {
                "max_length": 64
              }
            },
            "name": {
              "type": "string",
              "required": false,
              "description": "Feed-Titel (wird nicht angezeigt – Anzeige über headline).",
              "source": "product_feed"
            },
            "product_url": {
              "type": "url",
              "required": true,
              "description": "Produktdetailseite.",
              "source": "product_feed",
              "validation": {
                "https_only": true
              }
            },
            "image": {
              "type": "image",
              "required": true,
              "description": "Produktbild aus dem Feed.",
              "source": "product_feed",
              "validation": {
                "image_requirement": "product_image"
              },
              "fields": {
                "url": {
                  "type": "url",
                  "required": true,
                  "description": "Absolute HTTPS-URL (cairo.de / news.cairo.de).",
                  "source": "product_feed",
                  "validation": {
                    "https_only": true
                  }
                },
                "alt": {
                  "type": "string",
                  "required": true,
                  "description": "Alternativtext. Bei Grafiken mit eingebranntem Text MUSS der Bildtext enthalten sein.",
                  "source": "ai_agent",
                  "validation": {
                    "min_length": 3,
                    "max_length": 140
                  }
                },
                "width": {
                  "type": "integer",
                  "required": false,
                  "description": "Pixelbreite der Originaldatei.",
                  "source": "product_feed",
                  "validation": {
                    "min": 1
                  }
                },
                "height": {
                  "type": "integer",
                  "required": false,
                  "description": "Pixelhöhe der Originaldatei.",
                  "source": "product_feed",
                  "validation": {
                    "min": 1
                  }
                },
                "asset_id": {
                  "type": "string",
                  "required": false,
                  "description": "Asset-Referenz.",
                  "source": "product_feed"
                },
                "rights_status": {
                  "type": "enum",
                  "required": false,
                  "description": "Nutzungsfreigabe.",
                  "source": "product_feed",
                  "values": [
                    "approved",
                    "pending",
                    "unknown",
                    "rejected"
                  ],
                  "default": "unknown"
                }
              }
            },
            "price": {
              "type": "price",
              "required": true,
              "description": "Preis (wird mit * dargestellt).",
              "source": "product_feed"
            },
            "old_price": {
              "type": "price",
              "required": false,
              "description": "Streichpreis – erscheint als 'UVP / Katalogpreis' durchgestrichen.",
              "source": "product_feed"
            },
            "currency": {
              "type": "string",
              "required": false,
              "description": "Währung (Standard EUR).",
              "source": "product_feed"
            }
          }
        },
        "title": {
          "type": "string",
          "required": true,
          "description": "Kachelbeschriftung fett (14px), z. B. 'Weihnachten', 'Polstermöbel', 'Ashi'.",
          "source": "ai_agent",
          "validation": {
            "min_length": 2,
            "max_length": 22
          }
        },
        "subtitle": {
          "type": "string",
          "required": false,
          "description": "Optional Zusatzzeile (14px light), z. B. 'Holzkorb'.",
          "source": "ai_agent",
          "validation": {
            "max_length": 24
          }
        },
        "link_url": {
          "type": "url",
          "required": false,
          "description": "Ziel der Kachel (Kategorie-Seite). Standard: Produkt-URL bzw. Landingpage.",
          "source": "campaign_brief",
          "validation": {
            "https_only": true
          }
        }
      }
    },
    "tile_color": {
      "type": "enum",
      "required": false,
      "description": "Farbe des Beschriftungsfelds. Kategorien: hellblau oder blush; Produkte: Kampagnenfarbe.",
      "source": "ai_agent",
      "values": [
        "aubergine",
        "altrosa",
        "blush",
        "hellblau",
        "grau",
        "anthrazit"
      ],
      "default": "hellblau"
    },
    "two_lines": {
      "type": "boolean",
      "required": false,
      "description": "true, wenn Kacheln eine Zusatzzeile haben (gleich hohe Felder).",
      "source": "ai_agent",
      "default": false
    },
    "link_url": {
      "type": "url",
      "required": false,
      "description": "Fallback-Ziel.",
      "source": "campaign_brief",
      "validation": {
        "https_only": true
      }
    },
    "spacing_top": {
      "type": "enum",
      "required": false,
      "description": "Abstand oben. none = 0, s = 15px, m = 25px (Standard zwischen Bausteinen), l = 50px.",
      "source": "static_default",
      "values": [
        "none",
        "s",
        "m",
        "l"
      ],
      "default": "m"
    }
  },
  "image_requirements": [
    {
      "key": "tile_image",
      "field": "tiles[].image",
      "image_type": "category",
      "aspect_ratio": "1:1",
      "display_width": 184,
      "min_width": 368,
      "formats": [
        "jpg",
        "jpeg",
        "png"
      ],
      "alt_required": true,
      "focus": "Quadratische Szenen mit gleichem Seitenverhältnis",
      "rendering": "img"
    }
  ],
  "layout": {
    "desktop_columns": 3,
    "mobile_columns": 3,
    "full_width": true,
    "uses_background_image": false,
    "approx_height_px": {
      "desktop": 280,
      "mobile": 260
    }
  },
  "constraints": [
    "each_tile_needs_image_or_product"
  ],
  "exclusion_criteria": [],
  "compatibility": {
    "recommended_after": [
      "CA_PRODUCT_CARDS_01",
      "CA_PRODUCT_GRID_01"
    ],
    "recommended_before": [
      "CA_CODE_BANNER_01",
      "CA_BANNER_01",
      "CA_USP_01"
    ],
    "avoid_adjacent": [],
    "hard_dependencies": []
  },
  "ai_hints": {
    "when_to_use": "Mit heading_light 'Für Sie' + heading_bold 'ausgewählte Kategorien' (heading_bold_first false) für 3 Kategorien zum Thema; oder 3 kleine Produkte.",
    "when_not_to_use": "Mit Bildern sehr unterschiedlicher Formate.",
    "content_guidelines": "Titel 1–2 Wörter. Bilder quadratisch."
  }
}
